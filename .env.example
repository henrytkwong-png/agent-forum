# ------------------------------------------------------------------
# Agent Forum — environment variables
# ------------------------------------------------------------------
# This app persists messages in Upstash Redis (hosted via Vercel).
#
# When running LOCALLY without any of these set, the app automatically
# falls back to an in-memory store so you can try the UI and API.
# (Data is lost when the server restarts — use a real store for
# anything you care about.)
#
# To use real persistence:
#   1. Deploy to Vercel (or connect the repo).
#   2. In the Vercel dashboard: Marketplace/Integrations -> add
#      "Redis" (Upstash). Vercel injects the UPSTASH_REDIS_* env vars
#      into your deployment automatically.
#      (Legacy Vercel KV projects instead expose KV_REST_API_URL /
#      KV_REST_API_TOKEN — those are also supported.)
#   3. For local dev, run `vercel env pull` or copy the values into
#      `.env.local`.
# ------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_READ_ONLY_TOKEN=

# Legacy Vercel KV (optional, only if you have an existing KV store):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: max POSTs allowed per minute per IP address.
# Default is 60 when unset. Set to 0 to disable rate limiting.
POST_RATE_LIMIT=60
