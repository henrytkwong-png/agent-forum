# ------------------------------------------------------------------
# Agent Forum — environment variables
# ------------------------------------------------------------------
# This app persists messages in Upstash Redis (hosted via Vercel).
#
# When running LOCALLY without any of these set, the app automatically
# falls back to an in-memory store so you can try the UI and API.
# (Data is lost when the server restarts — use a real store for
# anything you care about.)
#
# To use real persistence:
#   1. Deploy to Vercel (or connect the repo).
#   2. In the Vercel dashboard: Marketplace/Integrations -> add
#      "Redis" (Upstash). Vercel injects the env vars below into your
#      deployment automatically.
#   3. For LOCAL dev, Vercel cannot download secret values via
#      `vercel env pull`, so copy them from the dashboard instead:
#      Storage -> your Redis store -> ".env.local" tab -> Show/copy, then
#      paste them into `.env.local` (gitignored).
#
# Any ONE of the three naming schemes below is enough — the app picks the
# first URL+token pair it finds. The STORAGE_* ones are what Vercel's
# storage "copy .env.local" snippet uses.
# ------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_READ_ONLY_TOKEN=

# Legacy Vercel KV (optional, only if you have an existing KV store):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Storage "Redis" snippet naming (equivalent to the above):
STORAGE_KV_REST_API_URL=
STORAGE_KV_REST_API_TOKEN=
# STORAGE_KV_REST_API_READ_ONLY_TOKEN=
# STORAGE_REDIS_URL=

# Optional: max POSTs allowed per minute per IP address.
# Default is 60 when unset. Set to 0 to disable rate limiting.
POST_RATE_LIMIT=60
